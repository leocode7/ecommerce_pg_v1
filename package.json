{
  "name": "ecommerce_pg_v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "services:stop": "docker compose -f src/infra/compose.yaml stop",
    "services:down": "docker compose -f src/infra/compose.yaml down",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "migration:create": "node-pg-migrate --migrations-dir src/infra/migrations create --migration-file-language ts",
    "migration:up": "node-pg-migrate --migrations-dir src/infra/migrations --envPath .env.development up"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "next": "16.3.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
